# Tara AI server
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Gemini (optional temporary provider; never commit the real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Web App placeholders (client config is in firebase-config.js)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# BSE — only use an official/licensed/authorized distribution endpoint
BSE_SECURITY_MASTER_URL=
BSE_SECURITY_MASTER_LICENSE_STATUS=
BSE_CORPORATE_DATA_URL=

# COMPANY 360 — only use an official/licensed/authorized disclosure ingestion endpoint.
# Provider payload must explicitly declare: verified=true, source=NSE_DISCLOSURES or BSE_DISCLOSURES, as_of_date=YYYY-MM-DD.
COMPANY_360_FINANCIALS_URL=
COMPANY_360_CORPORATE_ACTIONS_URL=
COMPANY_360_MANAGEMENT_URL=
COMPANY_360_NEWS_URL=

# LIVE MARKET DATA — every field below must match the provider contract.
# Tara blocks live display unless license status + display permission are explicitly allowed.
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER_NAME=
MARKET_DATA_PROVIDER_TYPE=
MARKET_DATA_LICENSE_STATUS=
MARKET_DATA_DISPLAY_PERMISSION=
MARKET_DATA_REDISTRIBUTION_PERMISSION=
MARKET_DATA_ATTRIBUTION_REQUIRED=
MARKET_DATA_AUTH_MODE=bearer
MARKET_DATA_API_KEY_HEADER=X-API-Key
MARKET_DATA_API_KEY_PARAM=apiKey
MARKET_DATA_SYMBOL_PARAM=symbol
MARKET_DATA_POLL_SYMBOLS=
MARKET_DATA_POLL_INTERVAL_MS=5000
MARKET_DATA_MAX_AGE_MS=30000
MARKET_DATA_STREAM_PROVIDER_NAME=

# Historical market data — official/licensed/authorized storage only.
# No database URL or permissions = explicit pending state. Never fabricate or interpolate candles.
TIMESCALE_DB_URL=
POSTGRES_URL=
TIMESCALE_DB_SSL=false
POSTGRES_SSL=false
HISTORICAL_STORAGE_LICENSE_STATUS=not-configured
HISTORICAL_STORAGE_DISPLAY_PERMISSION=not-configured
HISTORICAL_STORAGE_REDISTRIBUTION_PERMISSION=not-configured
HISTORICAL_STORAGE_SOURCE=NSE_BHAVCOPY
HISTORICAL_STORAGE_EXCHANGE=NSE
HISTORICAL_STORAGE_TABLE=ohlcv_daily
HISTORICAL_STORAGE_POOL_MAX=5

# Legacy direct historical provider configuration is retained for compatibility with existing tooling,
# but the company history API now uses the pluggable historical storage adapter above.
MARKET_HISTORY_API_URL=
MARKET_HISTORY_API_KEY=
MARKET_HISTORY_PROVIDER_NAME=
MARKET_HISTORY_PROVIDER_TYPE=
MARKET_HISTORY_LICENSE_STATUS=
MARKET_HISTORY_DISPLAY_PERMISSION=
MARKET_HISTORY_REDISTRIBUTION_PERMISSION=
MARKET_HISTORY_ATTRIBUTION_REQUIRED=
MARKET_HISTORY_AUTH_MODE=bearer
MARKET_HISTORY_API_KEY_PARAM=apiKey
MARKET_HISTORY_SYMBOL_PARAM=symbol
MARKET_HISTORY_FROM_PARAM=from
MARKET_HISTORY_TO_PARAM=to
MARKET_HISTORY_INTERVAL_PARAM=interval
MARKET_HISTORY_INSTRUMENT_KEY_TEMPLATE=
MARKET_HISTORY_INDEX_KEYS_JSON={}

# Financial / news intelligence
FINANCIAL_DATA_PROVIDER_NAME=
FINANCIAL_DATA_PROVIDER_TYPE=
FINANCIAL_DATA_LICENSE_STATUS=
NEWS_PROVIDER_NAME=
NEWS_PROVIDER_API_URL=
NEWS_PROVIDER_API_KEY=

# Tara model routing (temporary/replaceable provider only)
TARA_MODEL_PROVIDER_NAME=

# Never put real credentials in this file. Configure secrets in Render.
