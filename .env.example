# Tara AI server
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Gemini (optional provider; never commit the real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Web App placeholders (client config is in firebase-config.js)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# BSE — only use an official/licensed/authorized distribution endpoint
BSE_SECURITY_MASTER_URL=
BSE_SECURITY_MASTER_LICENSE_STATUS=
BSE_CORPORATE_DATA_URL=

# Market data provider
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER_NAME=
MARKET_DATA_PROVIDER_TYPE=
MARKET_DATA_LICENSE_STATUS=
MARKET_DATA_DISPLAY_PERMISSION=
MARKET_DATA_REDISTRIBUTION_PERMISSION=
MARKET_DATA_ATTRIBUTION_REQUIRED=
MARKET_DATA_STREAM_PROVIDER_NAME=

# Historical market data
MARKET_HISTORY_API_URL=
MARKET_HISTORY_API_KEY=
MARKET_HISTORY_PROVIDER_NAME=
MARKET_HISTORY_PROVIDER_TYPE=
MARKET_HISTORY_LICENSE_STATUS=
MARKET_HISTORY_DISPLAY_PERMISSION=
MARKET_HISTORY_REDISTRIBUTION_PERMISSION=
MARKET_HISTORY_ATTRIBUTION_REQUIRED=
MARKET_HISTORY_INSTRUMENT_KEY_TEMPLATE=

# Financial / news intelligence
FINANCIAL_DATA_PROVIDER_NAME=
NEWS_PROVIDER_NAME=
NEWS_PROVIDER_API_URL=
NEWS_PROVIDER_API_KEY=

# Tara model routing (temporary/replaceable provider only)
TARA_MODEL_PROVIDER_NAME=

# Never put real credentials in this file. Copy to .env locally or configure secrets in Render.
